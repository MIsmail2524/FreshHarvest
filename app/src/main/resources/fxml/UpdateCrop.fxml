<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.UpdateCropController"
      spacing="20"
      alignment="TOP_CENTER"
      stylesheets="@../css/application.css">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Update Crop" styleClass="page-title">
        <font><Font name="System Bold" size="24" /></font>
    </Label>

    <VBox styleClass="card" spacing="15" alignment="CENTER_LEFT" prefWidth="1000" prefHeight="700">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <!-- Name -->
        <VBox spacing="5">
            <Label text="Crop Name *" styleClass="label-primary"/>
            <TextField fx:id="txtCropName" styleClass="text-field full-width"/>
        </VBox>

        <!-- Type -->
        <VBox spacing="5">
            <Label text="Crop Type *" styleClass="label-primary"/>
            <TextField fx:id="txtCropType" styleClass="text-field full-width"/>
        </VBox>

        <!-- Season -->
        <VBox spacing="5">
            <Label text="Season" styleClass="label-primary"/>
            <ComboBox fx:id="comboSeason" promptText="Select season" styleClass="combo-box full-width"/>
        </VBox>

        <!-- Quantity -->
        <VBox spacing="5">
            <Label text="Quantity" styleClass="label-primary"/>
            <TextField fx:id="txtQuantity" styleClass="text-field full-width"/>
        </VBox>

        <!-- Field -->
        <VBox spacing="5">
            <Label text="Field" styleClass="label-primary"/>
            <TextField fx:id="txtField" styleClass="text-field full-width"/>
        </VBox>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Save Changes" onAction="#onUpdateCrop" styleClass="button" defaultButton="true"/>
            <Button text="Cancel" onAction="#onCancel" styleClass="button-secondary" cancelButton="true"/>
        </HBox>
    </VBox>
</VBox>
