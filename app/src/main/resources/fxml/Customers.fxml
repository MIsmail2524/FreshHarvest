<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.CustomersController"
      spacing="20"
      alignment="TOP_CENTER"
      prefWidth="1400" prefHeight="900"
      stylesheets="@../css/application.css">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Customer Management">
        <font>
            <Font name="System Bold" size="32" />
        </font>
    </Label>

    <!-- Statistics Section -->
    <HBox spacing="20" alignment="CENTER">
        <VBox alignment="CENTER" spacing="5" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Total Customers" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblTotalCustomers" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Active Customers" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblActiveCustomers" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="New This Month" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblNewThisMonth" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
            <Label text="Total Revenue" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblTotalRevenue" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: green;"/>
        </VBox>
    </HBox>

    <!-- Actions Section -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="lblSearchCount" text="Total: 0 customers" style="-fx-text-fill: #666; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="View Customer" onAction="#handleViewCustomer" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="Customer Report" onAction="#handleCustomerReport" style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
        <Button text="Refresh" onAction="#handleRefresh" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
    </HBox>

    <!-- Table Section -->
    <TableView fx:id="customersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCustomerId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCustomerName" text="Customer Name" prefWidth="200"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
            <TableColumn fx:id="colTotalOrders" text="Total Orders" prefWidth="100"/>
            <TableColumn fx:id="colTotalSpent" text="Total Spent" prefWidth="100"/>
            <TableColumn fx:id="colLastOrder" text="Last Order" prefWidth="120"/>
            <TableColumn fx:id="colCustomerSince" text="Customer Since" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>