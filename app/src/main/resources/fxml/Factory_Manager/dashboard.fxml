<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.Factory_Manager.DashboardController" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
<VBox stylesheets="@../../css/application.css" prefWidth="1400" prefHeight="900" spacing="32" alignment="TOP_LEFT" style="-fx-padding: 36; -fx-background-color: #f8f9fa;">

    <!-- Primary Header -->
    <VBox spacing="6">
        <Label text="🏗️ Factory Overview" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="High-level summary & quick actions" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- Key Metrics Placeholder -->
    <GridPane hgap="20" vgap="20">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);" GridPane.columnIndex="0" accessibleText="Pending batches count placeholder">
            <Label text="Pending Batches" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblPlaceholderPending" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);" GridPane.columnIndex="1" accessibleText="Today's completed batches placeholder">
            <Label text="Completed Today" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblPlaceholderCompleted" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);" GridPane.columnIndex="2" accessibleText="Average batch duration placeholder">
            <Label text="Avg Duration" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblPlaceholderDuration" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);" GridPane.columnIndex="3" accessibleText="Inventory health placeholder">
            <Label text="Inventory Health" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblPlaceholderInventory" text="—" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </GridPane>

    <!-- Action Panel -->
    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 10, 0, 0, 2);" accessibleText="Quick actions panel">
        <Label text="Quick Actions" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <FlowPane hgap="14" vgap="14" prefWrapLength="1000">
            <Button text="📦 Manage Batches" onAction="#closeApplication" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 10;"/>
            <Button text="🚚 Shipments" onAction="#closeApplication" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 10;"/>
            <Button text="📊 Reports" onAction="#closeApplication" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 10;"/>
            <Button text="🗂 Inventory" onAction="#closeApplication" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 10;"/>
            <Button text="⚙️ Settings" onAction="#closeApplication" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 10;"/>
        </FlowPane>
        <Separator/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="System Status:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblPlaceholderStatus" text="Nominal" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="❌ Close Application" onAction="#closeApplication" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 10;"/>
        </HBox>
    </VBox>

</VBox>
</ScrollPane>