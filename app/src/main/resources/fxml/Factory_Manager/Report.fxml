<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.Factory_Manager.FactoryReportsController"
    fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
<VBox spacing="24"
    prefWidth="1400" prefHeight="900"
    style="-fx-padding: 24; -fx-background-color: #f8f9fa;">
    
    <Label text="🏭 Factory Reports , Analytics"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <!-- Report Actions (Responsive) -->
        <FlowPane hgap="14" vgap="14" prefWrapLength="1200" alignment="CENTER_LEFT">
        <Button text="📊 Production Overview" onAction="#showProductionOverview" 
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        <Button text="📈 Batch Performance" onAction="#showBatchPerformance" 
            style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        <Button text="🥦 Quality Analysis" onAction="#showQualityAnalysis" 
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        <Button text="📦 Inventory Report" onAction="#showInventoryReport" 
            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        <Button text="💰 Cost Analysis" onAction="#showCostAnalysis" 
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        <Button text="🔄 Refresh Data" onAction="#refreshAllData" 
            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 10;"/>
        </FlowPane>

    <!-- Date Range Selector -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 18; -fx-background-color: #ecf0f1; -fx-background-radius: 12; -fx-border-radius: 12;">
        <Label text="Date Range:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbTimeRange" promptText="Select Time Range" style="-fx-pref-width: 150;"/>
        <Label text="From:" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dpStartDate" style="-fx-pref-width: 120;"/>
        <Label text="To:" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dpEndDate" style="-fx-pref-width: 120;"/>
        <Button text="Apply Filter" onAction="#applyDateFilter" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Quick Stats Grid -->
    <GridPane hgap="20" vgap="20" style="-fx-padding: 4 0 0 0;">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="20"/>
        </columnConstraints>
        <VBox alignment="CENTER" style="-fx-padding: 18; -fx-background-color: #3498db; -fx-background-radius: 14; -fx-min-width: 150;" GridPane.columnIndex="0" accessibleText="Total batches processed">
            <Label text="Total Batches" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Label fx:id="lblTotalBatches" text="0" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-padding: 18; -fx-background-color: #27ae60; -fx-background-radius: 14; -fx-min-width: 150;" GridPane.columnIndex="1" accessibleText="Completed batches count">
            <Label text="Completed" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Label fx:id="lblCompletedBatches" text="0" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-padding: 18; -fx-background-color: #f39c12; -fx-background-radius: 14; -fx-min-width: 150;" GridPane.columnIndex="2" accessibleText="Batch success rate percentage">
            <Label text="Success Rate" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Label fx:id="lblSuccessRate" text="0%" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-padding: 18; -fx-background-color: #e74c3c; -fx-background-radius: 14; -fx-min-width: 150;" GridPane.columnIndex="3" accessibleText="Average cost per batch">
            <Label text="Avg Cost/Batch" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Label fx:id="lblAvgCost" text="Rs. 0" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox alignment="CENTER" style="-fx-padding: 18; -fx-background-color: #9b59b6; -fx-background-radius: 14; -fx-min-width: 150;" GridPane.columnIndex="4" accessibleText="Total inventory value">
            <Label text="Inventory Value" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
            <Label fx:id="lblInventoryValue" text="Rs. 0" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
        </VBox>
    </GridPane>

    <!-- Chart Display Area -->
    <VBox fx:id="chartContainer" style="-fx-padding: 30; -fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3); -fx-min-height: 520; -fx-alignment: TOP_LEFT;" accessibleText="Dynamic report chart area">
        <Label text="Select a report type to view factory analytics" 
               style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
    </VBox>

   
</VBox>
</ScrollPane>