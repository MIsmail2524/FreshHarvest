<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.Factory_Manager.ShipmentController"
    prefWidth="1400" prefHeight="900"
    stylesheets="@../../css/application.css" spacing="20">
    
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox>
            <Label text="Logistics &amp; Shipments" styleClass="page-title"/>
            <Label text="Manage dispatch orders and assign tracking." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Create Shipment" onAction="#onCreateShipment" styleClass="primary-button"/>
        <Button text="🔄 Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
    </HBox>

    <!-- Statistics Cards -->
    <HBox spacing="15">
        <VBox styleClass="stat-card" prefWidth="200">
            <Label text="Pending Shipments" styleClass="stat-title"/>
            <Label fx:id="lblPendingCount" text="0" styleClass="stat-value" style="-fx-text-fill: #ef6c00;"/>
        </VBox>
        <VBox styleClass="stat-card" prefWidth="200">
            <Label text="Shipped Today" styleClass="stat-title"/>
            <Label fx:id="lblShippedCount" text="0" styleClass="stat-value" style="-fx-text-fill: #2e7d32;"/>
        </VBox>
        <VBox styleClass="stat-card" prefWidth="200">
            <Label text="Total Shipments" styleClass="stat-title"/>
            <Label fx:id="lblTotalCount" text="0" styleClass="stat-value" style="-fx-text-fill: #1976d2;"/>
        </VBox>
    </HBox>

    <!-- Filter Controls -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <ComboBox fx:id="cmbStatusFilter" promptText="Filter by Status" 
                 styleClass="filter-combo" prefWidth="150"/>
        <TextField fx:id="txtSearch" promptText="🔍 Search by Customer or Tracking..." 
                  styleClass="search-box" prefWidth="250"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="All Shipments" onAction="#onViewAllShipments" styleClass="secondary-button"/>
        <Button text="Pending Only" onAction="#onViewPendingOnly" styleClass="secondary-button"/>
    </HBox>

    <!-- Main Table -->
    <VBox styleClass="modern-table" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="shipmentTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colShipId" text="Shipment ID" prefWidth="80"/>
                <TableColumn fx:id="colCustomer" text="Customer" prefWidth="150"/>
                <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="100"/>

                <TableColumn fx:id="colCarrier" text="Carrier" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colTracking" text="Tracking Number" prefWidth="150"/>
                <TableColumn fx:id="colShipDate" text="Shipment Date" prefWidth="120"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Action Panel -->
    <VBox styleClass="action-panel" spacing="15">
        <Label text="📦 Shipment Actions" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>
        
        <!-- Selected Shipment Info -->
        <VBox spacing="5">
            <Label fx:id="lblSelectedShipment" text="No shipment selected" 
                  style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
        </VBox>
        
        <!-- Action Controls -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="5">
                <Label text="Tracking Number" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <TextField fx:id="txtTracking" promptText="Enter tracking number" prefWidth="200"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Update Status" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <ComboBox fx:id="cmbStatus" promptText="Select Status" prefWidth="150"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnConfirm" text="🚀 Confirm Dispatch" onAction="#onConfirmShipment" 
                   styleClass="primary-button" style="-fx-font-size: 14px;" disable="true"/>
            <Button fx:id="btnUpdate" text="💾 Update Status" onAction="#onUpdateStatus" 
                   styleClass="secondary-button" style="-fx-font-size: 14px;" disable="true"/>
        </HBox>
    </VBox>
</VBox>