<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.Factory_Manager.BatchManagementController"
    prefWidth="1400" prefHeight="900"
    stylesheets="@../../css/application.css" spacing="20">
    
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <!-- Header Section -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <VBox>
                <Label text="Batch Processing Management" styleClass="page-title"/>
                <Label text="Manage and track batch processing operations with crop association." styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="➕ Create Batch" onAction="#onCreateBatch" styleClass="primary-button"/>
            <Button text="🔄 Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        </HBox>
        
        <!-- Search and Filter Bar -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearch" promptText="🔍 Search by Batch ID, Process, Operator, or Crop..." 
                      styleClass="search-box" prefWidth="400"/>
            <ComboBox fx:id="cmbFilter" promptText="Filter by Status" 
                     styleClass="filter-combo" prefWidth="150"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total Batches:" style="-fx-text-fill: #637381; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalCount" text="0" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Main Table -->
    <VBox styleClass="modern-table" VBox.vgrow="ALWAYS" spacing="10">
        <TableView fx:id="batchTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBatchId" text="Process ID" prefWidth="80"/>
                <TableColumn fx:id="colCropId" text="Crop ID" prefWidth="70"/>
                <TableColumn fx:id="colCropName" text="Crop Name" prefWidth="150"/>
                <TableColumn fx:id="colProcessName" text="Process Name" prefWidth="180"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colGrade" text="Grade" prefWidth="90"/>
                <TableColumn fx:id="colOperator" text="Operator" prefWidth="120"/>
                <TableColumn fx:id="colStartTime" text="Start Time" prefWidth="100"/>
                <TableColumn fx:id="colProcessedDate" text="Processed Date" prefWidth="110"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Action Panel -->
    <VBox styleClass="action-panel" spacing="15">
        <Label text="📝 Batch Processing" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2c3e50;"/>
        
        <!-- Batch Details -->
        <VBox spacing="5">
            <Label fx:id="lblSelectedBatch" text="No batch selected" 
                  style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblBatchDetails" text="Select a batch to process" 
                  style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </VBox>
        
        <!-- Processing Controls -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="5" prefWidth="300">
                <Label text="Process Notes" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <TextArea fx:id="txtNotes" promptText="Enter process notes and observations..." 
                         prefHeight="60" wrapText="true" prefWidth="300"/>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Add Crop Selection ComboBox -->
            <VBox spacing="5">
                <Label text="Select Crop" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <ComboBox fx:id="cmbCrop" promptText="Select Crop" prefWidth="200"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Assign Grade" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <ComboBox fx:id="cmbGrade" promptText="Select Grade" prefWidth="120"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Update Status" style="-fx-font-weight: bold; -fx-text-fill: #637381;"/>
                <ComboBox fx:id="cmbStatus" promptText="Select Status" prefWidth="150"/>
            </VBox>

            <Button fx:id="btnSaveProcessing" text="💾 Save Processing" onAction="#onSaveProcessing" 
                   styleClass="primary-button" style="-fx-font-size: 14px;" disable="true"/>
        </HBox>
    </VBox>
</VBox>