<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.freshharvest.controller.Factory_Manager.PackageAndLabelController">
    
    <top>
        <VBox spacing="10" style="-fx-background-color: #2E8B57; -fx-padding: 15;">
            <Label text="Package and Label Batches" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
            <Label text="Prepare agricultural products for distribution with proper packaging and labeling" 
                   style="-fx-text-fill: #E8F5E8; -fx-font-size: 14px;" />
        </VBox>
    </top>
    
    <center>
        <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">
            
            <!-- Left Side: Packaging Form -->
            <VBox spacing="15" style="-fx-padding: 20;">
                <Label text="Batch Packaging Details" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                
                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="150" />
                        <ColumnConstraints prefWidth="250" />
                    </columnConstraints>
                    
                    <!-- Row 1: Batch Selection -->
                    <Label text="Select Batch:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <ComboBox fx:id="batchComboBox" promptText="Choose batch..." GridPane.rowIndex="0" GridPane.columnIndex="1" 
                              onAction="#handleBatchSelection" />
                    
                    <!-- Row 2: Product -->
                    <Label text="Product:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <ComboBox fx:id="productComboBox" promptText="Select product..." GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    
                    <!-- Row 3: Package Type -->
                    <Label text="Package Type:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <ComboBox fx:id="packageTypeComboBox" promptText="Choose package type..." GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    
                    <!-- Row 4: Quantity & Weight -->
                    <Label text="Quantity:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <TextField fx:id="quantityField" promptText="Enter quantity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    
                    <Label text="Total Weight (kg):" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                    <TextField fx:id="weightField" promptText="Enter total weight" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                    
                    <!-- Row 5: Packaging Date -->
                    <Label text="Packaging Date:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                    <DatePicker fx:id="packagingDatePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                    
                    <!-- Row 6: Batch ID -->
                    <Label text="Package Batch ID:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                    <TextField fx:id="batchIdField" promptText="Auto-generated" editable="false" 
                               style="-fx-background-color: #f0f0f0;" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                </GridPane>
                
                <!-- Quality Checks -->
                <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-radius: 5;">
                    <Label text="Quality Control Checks" style="-fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                    <CheckBox fx:id="qualityCheckBox" text="Quality Inspection Passed" />
                    <CheckBox fx:id="labelingCheckBox" text="Labeling Requirements Met" />
                    <CheckBox fx:id="packagingCheckBox" text="Packaging Standards Verified" />
                </VBox>
                
                <!-- Labeling Instructions -->
                <VBox spacing="5">
                    <Label text="Labeling Instructions/Special Notes:" />
                    <TextArea fx:id="labelingInstructionsArea" promptText="Enter any special labeling instructions..." 
                              prefRowCount="3" />
                </VBox>
                
                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="packageButton" text="Package Batch" 
                            style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold;"
                            onAction="#handlePackageBatch" disable="true" />
                    <Button fx:id="clearButton" text="Clear Form" 
                            style="-fx-background-color: #666666; -fx-text-fill: white;"
                            onAction="#handleClearForm" />
                    <Button fx:id="printLabelButton" text="Print Label" 
                            style="-fx-background-color: #4169E1; -fx-text-fill: white;"
                            onAction="#handlePrintLabel" disable="true" />
                    <Button fx:id="refreshButton" text="Refresh" 
                            style="-fx-background-color: #228B22; -fx-text-fill: white;"
                            onAction="#handleRefresh" />
                </HBox>
            </VBox>
            
            <!-- Right Side: Batch History Table -->
            <VBox spacing="10" style="-fx-padding: 20;">
                <Label text="Recently Packaged Batches" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />
                
                <TableView fx:id="batchesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="batchIdColumn" text="Batch ID" prefWidth="120" />
                        <TableColumn fx:id="productColumn" text="Product" prefWidth="150" />
                        <TableColumn fx:id="packageTypeColumn" text="Package Type" prefWidth="100" />
                        <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="80" />
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120" />
                        <TableColumn fx:id="dateColumn" text="Packaging Date" prefWidth="150" />
                    </columns>
                </TableView>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Double-click to print label" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
                </HBox>
            </VBox>
            
        </SplitPane>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: #f5f5f5; -fx-padding: 10;">
            <Label text="Packaging System v1.0 - Database Connected" style="-fx-text-fill: #666666; -fx-font-size: 12px;" />
        </HBox>
    </bottom>
    
</BorderPane>