<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.freshharvest.controller.CustomerControllers.AddOrderController"
            stylesheets="@../../css/application.css"
           prefWidth="1400" prefHeight="900">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Create New Order" 
                   style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            <Label text="Select products and add them to your cart" 
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.4" orientation="HORIZONTAL">
            <!-- Left: Product Selection Section -->
            <VBox spacing="20" style="-fx-padding: 20;">
                <Label text="Select Products" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <!-- Product Selection Form -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8f9fa; -fx-border-radius: 5;">
                    <Label text="Choose Product:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="productComboBox" prefWidth="300"/>
                    
                    <Label text="Quantity:" style="-fx-font-weight: bold;"/>
                    <Spinner fx:id="quantitySpinner" prefWidth="150"/>
                    
                    <Button fx:id="btnAddToCart" text="Add to Cart" 
                            styleClass="button-primary" 
                            style="-fx-font-size: 14px; -fx-pref-width: 120;"/>
                </VBox>
                
                <VBox spacing="10">
                    <Label text="Instructions:" style="-fx-font-weight: bold;"/>
                    <Label text="1. Select a product from dropdown" style="-fx-text-fill: #666;"/>
                    <Label text="2. Enter quantity" style="-fx-text-fill: #666;"/>
                    <Label text="3. Click 'Add to Cart'" style="-fx-text-fill: #666;"/>
                    <Label text="4. Repeat for more products" style="-fx-text-fill: #666;"/>
                </VBox>
            </VBox>

            <!-- Right: Cart Section -->
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f8f9fa;">
                <Label text="Shopping Cart" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                
                <!-- Cart Summary -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox>
                        <Label text="Items in Cart:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblItemCount" text="0 items" style="-fx-font-size: 16px; -fx-text-fill: #27ae60;"/>
                    </VBox>
                    <VBox>
                        <Label text="Total Amount:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalAmount" text="Rs. 0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </HBox>

                <!-- Cart Table -->
                <TableView fx:id="cartTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colCartProduct" text="Product" prefWidth="200"/>
                        <TableColumn fx:id="colCartPrice" text="Unit Price" prefWidth="100"/>
                        <TableColumn fx:id="colCartQuantity" text="Quantity" prefWidth="100"/>
                        <TableColumn fx:id="colCartSubtotal" text="Subtotal" prefWidth="100"/>
                        <TableColumn fx:id="colCartAction" text="Action" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Order Details Form -->
                <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;">
                    <Label text="Order Details" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="150"/>
                            <ColumnConstraints prefWidth="250"/>
                        </columnConstraints>
                        
                        <Label text="Payment Method:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="paymentMethodCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Clear Cart" onAction="#onClearCart" 
                            styleClass="button-secondary"/>
                    <Button text="Place Order" onAction="#onPlaceOrder" 
                            styleClass="button-primary" 
                            style="-fx-font-size: 14px; -fx-pref-width: 120;"/>
                    
                </HBox>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>