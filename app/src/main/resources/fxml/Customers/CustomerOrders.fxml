<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.CustomerControllers.CustomerOrdersController"
      spacing="15"
      prefWidth="1400" prefHeight="900"
      style="-fx-padding: 20;">
    
    <Label text="My Orders"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Statistics Cards -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox style="-fx-background-color: #3498db; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="Total Orders" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalOrders" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
        
        <VBox style="-fx-background-color: #f39c12; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="Pending Orders" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="lblPendingOrders" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
        
        <VBox style="-fx-background-color: #27ae60; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="Delivered Orders" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="lblDeliveredOrders" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
        
        <VBox style="-fx-background-color: #9b59b6; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
            <Label text="Total Spent" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="lblTotalSpent" text="Rs. 0.00" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Orders Table -->
    <VBox spacing="10">
        <Label text="Order History" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <TableView fx:id="ordersTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="80"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                <TableColumn fx:id="colTotalAmount" text="Total Amount" prefWidth="120"/>
                <TableColumn fx:id="colPaymentMethod" text="Payment Method" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_LEFT">
           <Button text="Refresh" onAction="#onRefresh" styleClass="button-secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <!-- Status Progress Bar at Bottom -->
    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 5; -fx-background-radius: 5;">
        <Label text="Order Status Progress" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <!-- Selected Order Info -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label fx:id="lblSelectedOrder" text="No order selected" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label fx:id="lblSelectedAmount" text="" style="-fx-text-fill: #7f8c8d;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblProgressPercentage" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #3498db; -fx-font-size: 16px;"/>
        </HBox>

        <!-- Multi-Segment Progress Bar -->
        <VBox spacing="5">
            <!-- Status Labels -->
            <HBox spacing="0" alignment="CENTER">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Pending" style="-fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-padding: 0 10 0 0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Accepted" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-padding: 0 10 0 0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Processing" style="-fx-text-fill: #9b59b6; -fx-font-weight: bold; -fx-padding: 0 10 0 0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Delivered" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-padding: 0 10 0 0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Received" style="-fx-text-fill: #1abc9c; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Main Progress Bar Container -->
            <StackPane fx:id="progressBarContainer" prefHeight="25" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1; -fx-border-radius: 3; -fx-background-radius: 3;">
                <!-- Background segments -->
                <HBox fx:id="progressSegments" spacing="0" style="-fx-background-color: transparent;">
                    <!-- Segments will be dynamically added here -->
                </HBox>
                
                <!-- Current position indicator -->
                <StackPane fx:id="currentPositionIndicator" style="-fx-alignment: CENTER; -fx-padding: 0 5 0 0;">
                    <Circle fx:id="positionCircle" radius="8" fill="#2c3e50" stroke="white" strokeWidth="2"/>
                    <Label fx:id="positionLabel" text="•" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </StackPane>
            </StackPane>

            <!-- Status Markers -->
            <HBox spacing="0" alignment="CENTER">
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="TOP_CENTER" spacing="2">
                    <Circle radius="4" fill="#f39c12"/>
                    <Line startX="0" endX="0" startY="0" endY="5" stroke="#bdc3c7" strokeWidth="1"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="TOP_CENTER" spacing="2">
                    <Circle radius="4" fill="#3498db"/>
                    <Line startX="0" endX="0" startY="0" endY="5" stroke="#bdc3c7" strokeWidth="1"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="TOP_CENTER" spacing="2">
                    <Circle radius="4" fill="#9b59b6"/>
                    <Line startX="0" endX="0" startY="0" endY="5" stroke="#bdc3c7" strokeWidth="1"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="TOP_CENTER" spacing="2">
                    <Circle radius="4" fill="#27ae60"/>
                    <Line startX="0" endX="0" startY="0" endY="5" stroke="#bdc3c7" strokeWidth="1"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="TOP_CENTER" spacing="2">
                    <Circle radius="4" fill="#1abc9c"/>
                    <Line startX="0" endX="0" startY="0" endY="5" stroke="#bdc3c7" strokeWidth="1"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Rejected Status Indicator -->
        <HBox fx:id="rejectedIndicator" alignment="CENTER" spacing="10" visible="false" style="-fx-padding: 5; -fx-background-color: #e74c3c; -fx-background-radius: 3;">
            <Text text="✗" style="-fx-fill: white; -fx-font-weight: bold;"/>
            <Label text="Order Rejected/Cancelled" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

</VBox>