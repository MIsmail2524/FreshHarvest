<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.ReportsController"
      spacing="20"
      alignment="TOP_CENTER"
      stylesheets="@../css/application.css">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Farm Analytics , Reports">
        <font>
            <Font name="System Bold" size="32" />
        </font>
    </Label>
<HBox spacing="15" alignment="CENTER">
        <Button text="Financial Summary" onAction="#handleFinancialSummary" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10;"/>
        <Button text="Crop Performance" onAction="#handleCropPerformance" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10;"/>
        <Button text="Seasonal Analysis" onAction="#handleSeasonalAnalysis" 
                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10;"/>
        <Button text="Expense Report" onAction="#handleExpenseReport" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-padding: 10;"/>
    </HBox>
    
    






 <!-- Simple Data Display -->
    <VBox spacing="10" alignment="TOP_CENTER">
        <Label text="Recent Transactions" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <TableView fx:id="reportTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="colReportDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colReportCategory" text="Category" prefWidth="120"/>
                <TableColumn fx:id="colReportDescription" text="Description" prefWidth="200"/>
                <TableColumn fx:id="colReportAmount" text="Amount" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

        <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER">
        <Button text="Generate Full Report" onAction="#handleGenerateReport" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;"/>
        <Button text="Export Data" onAction="#handleExportPDF" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20;"/>
        <Button text="Print Summary" onAction="#handlePrint" 
                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 10 20;"/>
    </HBox>
</VBox>
