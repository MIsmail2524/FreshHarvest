<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.ReportsController"
      spacing="15"
      alignment="TOP_CENTER"
      prefWidth="1400" prefHeight="900"
      styleClass="reports-container">

    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <!-- HEADER -->
    <Label text="Farm Analytics and Reports Dashboard" styleClass="header-label">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <!-- Report Type Buttons -->
    <HBox spacing="10" alignment="CENTER" styleClass="report-buttons-container">
        <Button text="📊 Crop Performance" onAction="#handleCropPerformance" styleClass="report-btn"/>
        <Button text="💰 Revenue Analysis" onAction="#handleRevenueAnalysis" styleClass="report-btn"/>
        <Button text="📈 Expense Breakdown" onAction="#handleExpenseBreakdown" styleClass="report-btn"/>
        <Button text="🌤️ Seasonal Analysis" onAction="#handleSeasonalAnalysis" styleClass="report-btn"/>
        <Button text="🥧 Profit Distribution" onAction="#handleProfitDistribution" styleClass="report-btn"/>
    </HBox>

    <!-- Chart Display Area -->
    <VBox fx:id="chartDisplayArea" spacing="15" styleClass="chart-display-area">
        <Label fx:id="currentChartTitle" text="Select a report type to view charts" styleClass="chart-main-title"/>
        
        <!-- Chart will be displayed here dynamically -->
        <StackPane fx:id="chartContainer" prefHeight="500" styleClass="chart-container"/>
    </VBox>

    <!-- Recent Transactions -->
    <VBox spacing="10" styleClass="table-container">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Recent Transactions" styleClass="section-title"/>
            <Button text="Refresh" onAction="#handleRefreshTransactions" styleClass="btn-refresh-small"/>
        </HBox>
        
        <TableView fx:id="reportTable" prefHeight="200">
            <columns>
                <TableColumn fx:id="colReportDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colReportCategory" text="Category" prefWidth="100"/>
                <TableColumn fx:id="colReportDescription" text="Description" prefWidth="300"/>
                <TableColumn fx:id="colReportAmount" text="Amount" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>