<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.BatchManagementController"
    stylesheets="@../css/factory_style.css" spacing="20">
    
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox>
            <Label text="Batch Management" styleClass="page-title"/>
            <Label text="Process and grade incoming harvests." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        
        <TextField fx:id="txtSearch" promptText="🔍 Search Batch ID..." styleClass="search-box" prefWidth="250"/>
        
        <ComboBox fx:id="cmbFilter" promptText="Filter by Status" styleClass="search-box"/>
    </HBox>

    <VBox styleClass="modern-table" VBox.vgrow="ALWAYS">
        <TableView fx:id="batchTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBatchId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colCropType" text="Crop" prefWidth="120"/>
                <TableColumn fx:id="colHarvestDate" text="Harvest Date" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                <TableColumn fx:id="colGrade" text="Grade" prefWidth="80"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>

    <HBox spacing="20" styleClass="stat-card" alignment="CENTER_LEFT">
        <Label text="Processing Action:" style="-fx-font-weight: bold;"/>
        
        <Label fx:id="lblSelectedBatch" text="No Batch Selected" style="-fx-text-fill: #637381;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <VBox spacing="5">
            <Label text="Assign Grade"/>
            <ComboBox fx:id="cmbGrade" promptText="Select" prefWidth="100"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Update Status"/>
            <ComboBox fx:id="cmbStatus" promptText="Select" prefWidth="150"/>
        </VBox>

        <Button text="Save Changes" onAction="#onSaveGrading" styleClass="primary-button" style="-fx-font-size: 14px;"/>
    </HBox>
</VBox>