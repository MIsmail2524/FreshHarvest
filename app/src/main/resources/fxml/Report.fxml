<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.ReportController"
    styleClass="content-pane" spacing="20">
    
    <padding>
        <Insets top="20" right="30" bottom="20" left="30" />
    </padding>

    <Label text="Generate Reports" styleClass="page-title" />
    <Label text="Generate and view reports for inventory, sales, and expenses." styleClass="page-subtitle" />
    
    <Separator />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Select Report Type:" styleClass="content-title" />
        <ComboBox fx:id="cmbReportType" prefWidth="250" />
        <Button fx:id="btnGenerateReport" text="Generate Report" onAction="#onGenerateReport" />
    </HBox>
    
    <Separator />

    <Label text="Report Output" styleClass="content-title" />
    <TextArea fx:id="reportTextArea" prefHeight="400.0" editable="false" />

</VBox>