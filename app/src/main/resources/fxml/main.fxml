<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane 
    xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.MainController"
    stylesheets="@../css/application.css">
  
  <!-- Sidebar -->
  <left>
    <VBox fx:id="sidebar" spacing="8.0" styleClass="sidebar" prefWidth="220.0">
      <Label text="FreshHarvest" styleClass="brand"/>
      <Separator/>
      <Button fx:id="btnDashboard" text="Dashboard" onAction="#onDashboard"/>
    </VBox>
  </left>

  <!-- Main content area where child screens are loaded -->
  <center>
    <AnchorPane fx:id="contentPane" styleClass="content-pane"/>
  </center>
</BorderPane>
