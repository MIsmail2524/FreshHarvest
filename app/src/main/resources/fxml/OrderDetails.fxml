<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.OrderDetailsController"
      prefWidth="1400" prefHeight="900"
      spacing="15" alignment="TOP_LEFT">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Order Details" styleClass="page-title">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <GridPane hgap="10" vgap="10">
        <Label text="Order ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblOrderId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Order Number:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblOrderNumber" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Customer Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblCustomerName" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Customer Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lblCustomerEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Customer Phone:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="lblCustomerPhone" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Order Date:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="lblOrderDate" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Total Amount:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <Label fx:id="lblTotalAmount" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Status:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <Label fx:id="lblStatus" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Delivery Type:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <Label fx:id="lblDeliveryType" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

        <Label text="Delivery Address:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <Label fx:id="lblDeliveryAddress" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <Label text="Notes:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
        <Label fx:id="lblNotes" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Close" onAction="#closePopup" styleClass="button-secondary" alignment="CENTER"/>
</VBox>
