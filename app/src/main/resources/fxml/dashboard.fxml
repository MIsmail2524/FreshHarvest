<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.freshharvest.controller.DashboardController" fitToWidth="true" hbarPolicy="NEVER">
<VBox prefWidth="1400" prefHeight="900" spacing="24" alignment="TOP_CENTER" style="-fx-padding: 0 0 30 0;">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="Dashboard" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
    
    <!-- Chart Selection Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Crop Performance" onAction="#showCropPerformanceChart" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        <Button text="Order Status" onAction="#showOrderStatusChart" style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
        <Button text="Expense Breakdown" onAction="#showExpenseBreakdownChart" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        <Button text="Refresh" onAction="#refreshDashboard" style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
    </HBox>

    <!-- Chart Container -->
    <VBox fx:id="chartContainer" prefHeight="400" prefWidth="800" 
          style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;"/>

    <!-- Statistics Cards -->
    <HBox spacing="20" alignment="CENTER">
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Orders" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblOrders" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Crops" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblCrops" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Batches" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblBatches" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Total Harvested" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblTotalHarvested" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Total Expense" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblTotalExpense" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Profit/Loss" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblProfitLoss" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <VBox style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 15;" prefWidth="250" prefHeight="120">
            <Label text="Weather" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            <Label fx:id="lblWeather" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
</VBox>
</ScrollPane>