<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.freshharvest.controller.DashboardController" spacing="20" alignment="CENTER">


    <Label text="Dashboard" styleClass="page-title">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
    </Label>
    
   <HBox spacing="20" alignment="CENTER_LEFT">
        <!-- Large Orders Box -->
        <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text=" Orders" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
            <ProgressBar progress="0.7" prefWidth="200"/>
            <Label text="70% completion rate" styleClass="label-muted"/>
        </VBox>
                <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Crops" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
           
        </VBox>
                <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Batches" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
          
        </VBox>
          </HBox>

   <HBox spacing="20" alignment="CENTER_LEFT">
        <!-- Large Orders Box -->
        <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text=" Total Harvested" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
            <ProgressBar progress="0.7" prefWidth="200"/>
            <Label text="70% completion rate" styleClass="label-muted"/>
        </VBox>
                <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Total Expense" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
           
        </VBox>
                <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Proft/Loss" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
            <Label text="+12 this week" styleClass="metric-change positive"/>
          
        </VBox>
          </HBox>

      <HBox spacing="20" alignment="CENTER_LEFT">
        <!-- Large Orders Box -->
        <VBox styleClass="card" spacing="15" alignment="CENTER" prefWidth="300" prefHeight="200">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Weather" styleClass="label-primary"/>
            <Label text="142 Total" styleClass="metric-value"/>
           
            <Label text="70% completion rate" styleClass="label-muted"/>
        </VBox>
          </HBox>
        
  
    
  
    <Button text="Exit" onAction="#closeApplication" />
</VBox>