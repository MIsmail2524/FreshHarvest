<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.freshharvest.controller.SignupController"
            stylesheets="@../css/application.css"
            prefWidth="1500" prefHeight="650">

    <!-- Left Side - Brand/Image Section -->
    <left>
        <VBox styleClass="brand-section" alignment="CENTER" spacing="30" prefWidth="500">
            <!-- Logo and Brand -->
            <VBox alignment="CENTER" spacing="15">
                <ImageView fitWidth="500" fitHeight="500" preserveRatio="true">
                    <Image url="@../image/logo.png"/>
                </ImageView>
                <VBox alignment="CENTER" spacing="8">
                    <Label text="Join Our Farming Community" styleClass="brand-subtitle"/>
                </VBox>
            </VBox>

            <!-- Feature Highlights -->
            <VBox styleClass="features-box" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="12">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="24" fitHeight="24">
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="For Farmers" styleClass="feature-title"/>
                            <Label text="Manage your farm operations" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="24" fitHeight="24">
                            <Image url="@../images/icon-customer.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="For Customers" styleClass="feature-title"/>
                            <Label text="Access fresh local produce" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="24" fitHeight="24">
                            <Image url="@../images/icon-factory.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="For Factories" styleClass="feature-title"/>
                            <Label text="Streamline production processes" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Benefits -->
            <VBox styleClass="testimonial-box" alignment="CENTER_LEFT" spacing="15">
                <Label text="Why Join FreshHarvest?" styleClass="feature-title"/>
                <VBox spacing="8">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Direct farm-to-table connection" styleClass="feature-desc"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Real-time order tracking" styleClass="feature-desc"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Secure payment processing" styleClass="feature-desc"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="24/7 customer support" styleClass="feature-desc"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Testimonial -->
            <VBox styleClass="testimonial-box" alignment="CENTER" spacing="10">
                <TextFlow textAlignment="CENTER">
                    <Text text="&quot;" styleClass="quote-mark"/>
                    <Text text="Since joining FreshHarvest, my farm's revenue increased by 40% through direct sales!" styleClass="testimonial-text"/>
                    <Text text="&quot;" styleClass="quote-mark"/>
                </TextFlow>
                <Label text="- Michael Chen, Local Farmer" styleClass="testimonial-author"/>
            </VBox>
        </VBox>
    </left>

    <!-- Right Side - Signup Form -->
    <center>
        <VBox styleClass="login-form-section" alignment="CENTER" spacing="25" prefWidth="500">
            <!-- Welcome Header -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Join FreshHarvest!" styleClass="welcome-title"/>
                <Label text="Create your account in seconds" styleClass="welcome-subtitle"/>
            </VBox>

            <!-- Signup Form -->
            <VBox styleClass="form-container" spacing="20" prefWidth="380">
                <!-- Two-column layout for name fields -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <!-- First Name -->
                    <VBox styleClass="form-field" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="First Name" styleClass="field-label"/>
                        <HBox styleClass="input-container" spacing="10">
                            <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                                <Image url="@../images/icon-user.png"/>
                            </ImageView>
                            <TextField fx:id="txtFirstName" 
                                      styleClass="modern-text-field"
                                      promptText="First name"
                                      onKeyPressed="#onKeyPressed"/>
                        </HBox>
                    </VBox>

                    <!-- Last Name -->
                    <VBox styleClass="form-field" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Last Name" styleClass="field-label"/>
                        <HBox styleClass="input-container" spacing="10">
                            <TextField fx:id="txtLastName" 
                                      styleClass="modern-text-field"
                                      promptText="Last name"
                                      onKeyPressed="#onKeyPressed"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Username Field -->
                <VBox styleClass="form-field" spacing="8">
                    <Label text="Username" styleClass="field-label"/>
                    <HBox styleClass="input-container" spacing="10">
                        <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                            <Image url="@../images/icon-at.png"/>
                        </ImageView>
                        <TextField fx:id="txtUsername" 
                                  styleClass="modern-text-field"
                                  promptText="Choose a username"
                                  onKeyPressed="#onKeyPressed"/>
                    </HBox>
                </VBox>

                <!-- Email Field -->
                <VBox styleClass="form-field" spacing="8">
                    <Label text="Email Address" styleClass="field-label"/>
                    <HBox styleClass="input-container" spacing="10">
                        <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                            <Image url="@../images/icon-email.png"/>
                        </ImageView>
                        <TextField fx:id="txtEmail" 
                                  styleClass="modern-text-field"
                                  promptText="your.email@example.com"
                                  onKeyPressed="#onKeyPressed"/>
                    </HBox>
                </VBox>

                <!-- Two-column layout for passwords -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <!-- Password -->
                    <VBox styleClass="form-field" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Password" styleClass="field-label"/>
                        <HBox styleClass="input-container" spacing="10">
                            <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                                <Image url="@../images/icon-lock.png"/>
                            </ImageView>
                            <PasswordField fx:id="txtPassword" 
                                          styleClass="modern-text-field"
                                          promptText="••••••••"
                                          onKeyPressed="#onKeyPressed"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm Password -->
                    <VBox styleClass="form-field" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Confirm" styleClass="field-label"/>
                        <HBox styleClass="input-container" spacing="10">
                            <PasswordField fx:id="txtConfirmPassword" 
                                          styleClass="modern-text-field"
                                          promptText="••••••••"
                                          onKeyPressed="#onKeyPressed"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Role Field -->
                <VBox styleClass="form-field" spacing="8">
                    <Label text="I am a..." styleClass="field-label"/>
                    <HBox styleClass="input-container" spacing="10">
                        <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                            <Image url="@../images/icon-role.png"/>
                        </ImageView>
                        <ComboBox fx:id="cmbRole" 
                                 styleClass="modern-combobox"
                                 promptText="Select your role"/>
                    </HBox>
                </VBox>

                <!-- Terms and Conditions -->
                <VBox styleClass="form-field" spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkTerms" styleClass="terms-checkbox"/>
                        <TextFlow styleClass="terms-text">
                            <Text text="I agree to the "/>
                            <Text text="Terms of Service" styleClass="terms-link"/>
                            <Text text=" and "/>
                            <Text text="Privacy Policy" styleClass="terms-link"/>
                        </TextFlow>
                    </HBox>
                </VBox>

                <!-- Error Message -->
                <VBox fx:id="errorContainer" styleClass="error-container" visible="false" managed="false">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-error.png"/>
                        </ImageView>
                        <Label fx:id="lblError" styleClass="error-text" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Signup Button -->
                <VBox spacing="15">
                    <Button fx:id="btnSignup" 
                           text="Create Account" 
                           styleClass="login-button"
                           onAction="#onSignup" 
                           defaultButton="true"/>

                    <ProgressIndicator fx:id="progressIndicator" 
                                      styleClass="login-progress"
                                      visible="false"/>
                </VBox>

                <!-- Divider -->
                <HBox alignment="CENTER" spacing="10">
                    <Region styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                    <Label text="Already have an account?" styleClass="divider-text"/>
                    <Region styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Alternative Options -->
                <VBox spacing="12" alignment="CENTER">
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnBackToLogin" 
                               text="Sign In Instead" 
                               styleClass="secondary-button"
                               onAction="#onBackToLogin"/>
                               
                        <Button fx:id="btnExit" 
                               text="Exit" 
                               styleClass="text-button"
                               onAction="#onExit"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Footer -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="© 2025 FreshHarvest" styleClass="footer-text"/>
                <Label text="Farm Management System v2.0" styleClass="footer-subtext"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>