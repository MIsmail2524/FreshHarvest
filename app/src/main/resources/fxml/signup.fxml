<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.freshharvest.controller.SignupController"
            stylesheets="@../css/application.css"
            prefWidth="1200" prefHeight="700">

    <!-- Left Side - Brand/Image Section -->
    <left>
        <VBox alignment="CENTER" spacing="20" prefWidth="450" 
              style="-fx-background-color: linear-gradient(to bottom right, #27ae60, #2ecc71); -fx-padding: 30;">
            <!-- Logo and Brand -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="80" fitHeight="80" preserveRatio="true">
                    <Image url="@../image/logo.png"/>
                </ImageView>
                <Label text="FreshHarvest" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Join Our Farming Community" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;"/>
            </VBox>

            <!-- Feature Highlights -->
            <VBox alignment="CENTER_LEFT" spacing="12" 
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 12; -fx-border-width: 1;">
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                            <Image url="@../images/icon-customer.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="For Customers" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                            <Label text="Access fresh local produce" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                            <Image url="@../images/icon-factory.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="For Factories" style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600;"/>
                            <Label text="Streamline production" style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Benefits -->
            <VBox alignment="CENTER_LEFT" spacing="10" 
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 12; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 12; -fx-border-width: 1;">
                <Label text="Why Join?" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <VBox spacing="6">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="14" fitHeight="14">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Direct farm-to-table connection" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="14" fitHeight="14">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Real-time order tracking" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="14" fitHeight="14">
                            <Image url="@../images/icon-check.png"/>
                        </ImageView>
                        <Label text="Secure payment processing" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 11px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- Right Side - Signup Form -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: white; -fx-background: white;" hbarPolicy="NEVER">
            <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 30 25;">
                <!-- Welcome Header -->
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Join FreshHarvest!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label text="Create your account in seconds" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                </VBox>

                <!-- Signup Form -->
                <VBox spacing="14" prefWidth="360" maxWidth="360">
                    <!-- Full Name Field -->
                    <VBox spacing="5">
                        <Label text="Full Name" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <Image url="@../images/icon-user.png"/>
                            </ImageView>
                            <TextField fx:id="txtFirstName" 
                                      styleClass="modern-text-field"
                                      promptText="Full name"
                                      onKeyPressed="#onKeyPressed"
                                      HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Username Field -->
                    <VBox spacing="5">
                        <Label text="Username" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <Image url="@../images/icon-at.png"/>
                            </ImageView>
                            <TextField fx:id="txtUsername" 
                                      styleClass="modern-text-field"
                                      promptText="Choose a username"
                                      onKeyPressed="#onKeyPressed"
                                      HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Email Field -->
                    <VBox spacing="5">
                        <Label text="Email Address" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <Image url="@../images/icon-email.png"/>
                            </ImageView>
                            <TextField fx:id="txtEmail" 
                                      styleClass="modern-text-field"
                                      promptText="your.email@example.com"
                                      onKeyPressed="#onKeyPressed"
                                      HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Password Field -->
                    <VBox spacing="5">
                        <Label text="Password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <Image url="@../images/icon-lock.png"/>
                            </ImageView>
                            <PasswordField fx:id="txtPassword" 
                                          styleClass="modern-text-field"
                                          promptText="Create password"
                                          onKeyPressed="#onKeyPressed"
                                          HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm Password Field -->
                    <VBox spacing="5">
                        <Label text="Confirm Password" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <PasswordField fx:id="txtConfirmPassword" 
                                          styleClass="modern-text-field"
                                          promptText="Confirm password"
                                          onKeyPressed="#onKeyPressed"
                                          HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Role Field -->
                    <VBox spacing="5">
                        <Label text="I am a..." style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="8" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 9 12;">
                            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                <Image url="@../images/icon-role.png"/>
                            </ImageView>
                            <ComboBox fx:id="cmbRole" 
                                     styleClass="modern-combobox"
                                     promptText="Select your role"
                                     maxWidth="Infinity"
                                     HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Terms and Conditions -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <CheckBox fx:id="chkTerms"/>
                        <Label text="I agree to the Terms of Service" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                    </HBox>

                    <!-- Error Message -->
                    <VBox fx:id="errorContainer" visible="false" managed="false" 
                          style="-fx-background-color: #ffeaea; -fx-background-radius: 6; -fx-border-color: #e74c3c; -fx-border-radius: 6; -fx-border-width: 1; -fx-padding: 9 12;">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <ImageView fitWidth="14" fitHeight="14">
                                <Image url="@../images/icon-error.png"/>
                            </ImageView>
                            <Label fx:id="lblError" wrapText="true" style="-fx-text-fill: #c0392b; -fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>

                    <!-- Signup Button -->
                    <VBox spacing="10">
                        <Button fx:id="btnSignup" 
                               text="Create Account" 
                               styleClass="login-button"
                               onAction="#onSignup" 
                               defaultButton="true"
                               maxWidth="Infinity"/>

                        <ProgressIndicator fx:id="progressIndicator" 
                                          visible="false"
                                          prefWidth="28" prefHeight="28"/>
                    </VBox>

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="8">
                        <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-pref-height: 1;"/>
                        <Label text="Already have an account?" style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
                        <Region HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-pref-height: 1;"/>
                    </HBox>

                    <!-- Alternative Options -->
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnBackToLogin" 
                               text="Sign In Instead" 
                               styleClass="secondary-button"
                               onAction="#onBackToLogin"/>
                               
                        <Button fx:id="btnExit" 
                               text="Exit" 
                               styleClass="text-button"
                               onAction="#onExit"/>
                    </HBox>
                </VBox>

                <!-- Footer -->
                <VBox alignment="CENTER" spacing="3">
                    <Label text="© 2025 FreshHarvest" style="-fx-text-fill: #95a5a6; -fx-font-size: 10px;"/>
                    <Label text="Farm Management System v2.0" style="-fx-text-fill: #bdc3c7; -fx-font-size: 9px;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>