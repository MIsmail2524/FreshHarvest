<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.freshharvest.controller.LoginController"
            stylesheets="@../css/application.css"
            prefWidth="1500" prefHeight="650">

    <!-- Left Side - Brand/Image Section -->
    <left>
        <VBox styleClass="brand-section" alignment="CENTER" spacing="30" prefWidth="500">
            <!-- Logo and Brand -->
            <VBox alignment="CENTER" spacing="15">
                <ImageView fitWidth="120" fitHeight="120" preserveRatio="true">
                    <Image url="@../images/freshharvest-logo.png"/>
                </ImageView>
                <VBox alignment="CENTER" spacing="8">
                    <Label text="Farm to Table Excellence" styleClass="brand-subtitle"/>
                </VBox>
            </VBox>

            <!-- Feature Highlights -->
            <VBox styleClass="features-box" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="12">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="24" fitHeight="24">
                            <Image url="@../images/icon-fresh.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="Fresh Produce" styleClass="feature-title"/>
                            <Label text="Direct from local farms" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="500" fitHeight="500">
                            <Image url="@../image/logo.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="Fast Delivery" styleClass="feature-title"/>
                            <Label text="Same day delivery available" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="24" fitHeight="24">
                            <Image url="@../images/icon-quality.png"/>
                        </ImageView>
                        <VBox spacing="2">
                            <Label text="Premium Quality" styleClass="feature-title"/>
                            <Label text="100% organic and natural" styleClass="feature-desc"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Testimonial -->
            <VBox styleClass="testimonial-box" alignment="CENTER" spacing="10">
                <TextFlow textAlignment="CENTER">
                    <Text text="&quot;" styleClass="quote-mark"/>
                    <Text text="FreshHarvest delivers the freshest produce right to my doorstep. Amazing service!" styleClass="testimonial-text"/>
                    <Text text="&quot;" styleClass="quote-mark"/>
                </TextFlow>
                <Label text="- Sarah Johnson, Regular Customer" styleClass="testimonial-author"/>
            </VBox>
        </VBox>
    </left>

    <!-- Right Side - Login Form -->
    <center>
        <VBox styleClass="login-form-section" alignment="CENTER" spacing="30" prefWidth="500">
            <!-- Welcome Header -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Welcome Back!" styleClass="welcome-title"/>
                <Label text="Sign in to your account" styleClass="welcome-subtitle"/>
            </VBox>

            <!-- Login Form -->
            <VBox styleClass="form-container" spacing="25" prefWidth="350">
                <!-- Username Field -->
                <VBox styleClass="form-field" spacing="8">
                    <Label text="Username" styleClass="field-label"/>
                    <HBox styleClass="input-container" spacing="10">
                        <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                            <Image url="@../images/icon-user.png"/>
                        </ImageView>
                        <TextField fx:id="txtUsername" 
                                  styleClass="modern-text-field"
                                  promptText="Enter your username"
                                  onKeyPressed="#onKeyPressed"/>
                    </HBox>
                </VBox>

                <!-- Password Field -->
                <VBox styleClass="form-field" spacing="8">
                    <Label text="Password" styleClass="field-label"/>
                    <HBox styleClass="input-container" spacing="10">
                        <ImageView fitWidth="20" fitHeight="20" styleClass="input-icon">
                            <Image url="@../images/icon-lock.png"/>
                        </ImageView>
                        <PasswordField fx:id="txtPassword" 
                                      styleClass="modern-text-field"
                                      promptText="Enter your password"
                                      onKeyPressed="#onKeyPressed"/>
                    </HBox>
                </VBox>

                <!-- Error Message -->
                <VBox fx:id="errorContainer" styleClass="error-container" visible="false" managed="false">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@../images/icon-error.png"/>
                        </ImageView>
                        <Label fx:id="lblError" styleClass="error-text" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Login Button -->
                <VBox spacing="15">
                    <Button fx:id="btnLogin" 
                           text="Sign In" 
                           styleClass="login-button"
                           onAction="#onLogin" 
                           defaultButton="true"/>

                    <ProgressIndicator fx:id="progressIndicator" 
                                      styleClass="login-progress"
                                      visible="false"/>
                </VBox>

                <!-- Divider -->
                <HBox alignment="CENTER" spacing="10">
                    <Region styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                    <Label text="or" styleClass="divider-text"/>
                    <Region styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Alternative Options -->
                <VBox spacing="12" alignment="CENTER">
                    <Label text="Don't have an account?" styleClass="alternative-text"/>
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnSignup" 
                               text="Create Account" 
                               styleClass="secondary-button"
                               onAction="#onSignup"/>
                               
                        <Button fx:id="btnExit" 
                               text="Exit" 
                               styleClass="text-button"
                               onAction="#onExit"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Footer -->
            <VBox alignment="CENTER" spacing="5">
                <Label text="© 2025 FreshHarvest" styleClass="footer-text"/>
                <Label text="Farm Management System v2.0" styleClass="footer-subtext"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>